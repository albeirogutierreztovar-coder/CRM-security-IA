# GEMINI_API_KEY: Requerido para llamadas backend al SDK @google/genai (Security AI Assistant).
# AI Studio inyecta esto automáticamente en runtime desde Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base de la aplicación.
APP_URL="MY_APP_URL"

# Puerto de ejecución del servidor Express + Vite
PORT=3000

# SUPABASE CONFIGURATION:
# URL de la instancia de Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Clave anónima pública de Supabase para cliente frontend con Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Clave de servicio para Supabase (SOLO backend/Edge Functions - NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
